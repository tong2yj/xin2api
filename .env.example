# ============================================
# Xin2API 配置文件
# ============================================
# 复制此文件为 .env 并修改相应配置
# cp .env.example .env

# ============================================
# 基础配置
# ============================================

# 数据库配置
# SQLite (默认，适合小型部署):
DATABASE_URL=sqlite+aiosqlite:///./data/gemini_proxy.db
# PostgreSQL (高并发推荐):
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/xin2api

# JWT 密钥 (请修改为随机字符串！)
SECRET_KEY=your-super-secret-key-change-this-in-production

# 管理员账号（首次启动会自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 服务配置
HOST=0.0.0.0
PORT=10601

# ============================================
# gcli2api 桥接配置（必需）
# ============================================
# 重要：Xin2API 必须连接到 gcli2api 服务才能使用 Gemini 和 Antigravity 模型
# ============================================

# gcli2api 服务地址
# 根据你的部署方式选择：
# - 同一 Docker 网络：http://gcli2api-service:7861
# - 宿主机网络：http://localhost:7861
# - 不同主机：http://192.168.1.100:7861
GCLI2API_BASE_URL=http://localhost:7861

# gcli2api API 密码 (用于调用聊天接口)
# 需要与 gcli2api 项目的 API_PASSWORD 保持一致
GCLI2API_API_PASSWORD=your_gcli2api_api_password

# gcli2api 面板密码 (用于调用管理接口)
# 需要与 gcli2api 项目的 PANEL_PASSWORD 保持一致
GCLI2API_PANEL_PASSWORD=your_gcli2api_panel_password

# ============================================
# 用户配置
# ============================================

# 用户默认配额 (每日请求数)
DEFAULT_DAILY_QUOTA=100

# 凭证奖励配额 (上传凭证到公共池的奖励)
CREDENTIAL_REWARD_QUOTA=1000

# 注册开关
ALLOW_REGISTRATION=true

# ============================================
# 端点配置
# ============================================

# Gemini API 基础地址
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# 端点优先级顺序（逗号分隔）
# 可选值: gcli2api, antigravity, openai
# 系统会按顺序尝试每个端点，直到成功或全部失败
ENDPOINT_PRIORITY=gcli2api,antigravity,openai

# ============================================
# 模型访问控制
# ============================================
# 配置所有用户统一可见和可使用的模型列表
# 注意：这些配置可以在管理后台界面动态修改，无需重启服务
# ============================================

# 过滤模式
# - disabled: 不过滤，显示所有可用模型（默认）
# - rules: 规则过滤，根据模型类型和功能过滤
# - whitelist: 白名单模式，精确指定可用模型列表
MODEL_FILTER_MODE=disabled

# 允许的模型层级（逗号分隔）
# 可选值: 2.5, 3
# 示例: MODEL_TIER_LIMIT=2.5 表示只允许 Gemini 2.5 系列
MODEL_TIER_LIMIT=2.5,3

# 是否启用 Claude 模型
ENABLE_CLAUDE_MODELS=true

# 是否启用 Thinking 后缀模型
# 包括: -thinking, -maxthinking, -nothinking 后缀的模型
ENABLE_THINKING_MODELS=true

# 是否启用 Search 后缀模型
# 包括: -search 后缀的搜索增强模型
ENABLE_SEARCH_MODELS=true

# 白名单模式下启用的模型列表（JSON 数组格式）
# 仅在 MODEL_FILTER_MODE=whitelist 时生效
# 示例: ENABLED_MODELS=["gemini-2.5-flash","gemini-3-pro-preview","claude-sonnet-4-5"]
ENABLED_MODELS=
